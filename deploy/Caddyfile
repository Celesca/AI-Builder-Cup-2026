# One VM, two HTTPS hosts. Caddy obtains and renews both certificates.
# DNS for both domains must point at this VM; open TCP 80/443 and UDP 443.
# docker-compose.https.yml uses this instead of nginx (never bind both to port 80).

(long_requests) {
	request_body {
		max_size 550MB
	}
}

{$DOMAIN:valz.limitlesstech-co.com} {
	import long_requests
	encode zstd gzip

	# Optional password protection must cover BOTH hosts, not just the dashboard.
	# CORS is not authentication; public API calls can spend model credits.

	# Keep the dashboard's API documentation links working.
	@apidocs path /docs /redoc /openapi.json
	handle @apidocs {
		reverse_proxy api:8000
	}

	# /api/* remains available through the SvelteKit proxy as a same-origin fallback.
	handle {
		reverse_proxy frontend:3000 {
			flush_interval -1
			transport http {
				dial_timeout 60s
				response_header_timeout 900s
				read_timeout 900s
				write_timeout 900s
			}
		}
	}
}

{$API_DOMAIN:gemba.limitlesstech-co.com} {
	import long_requests

	# Preserve older clients using https://gemba.limitlesstech-co.com/api/*.
	handle_path /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				dial_timeout 60s
				response_header_timeout 900s
				read_timeout 900s
				write_timeout 900s
			}
		}
	}

	# Canonical API URLs: /health, /docs, /analysis/*, /safety/*, /voice/*, etc.
	handle {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				dial_timeout 60s
				response_header_timeout 900s
				read_timeout 900s
				write_timeout 900s
			}
		}
	}
}
