# Copy to .env (git-ignored). server.py and docker compose both read it.
OPENROUTER_API_KEY=

# Use Gemini directly instead of OpenRouter: put a Google AI Studio key in OPENROUTER_API_KEY, uncomment the URL,
# and use Gemini model ids without the "google/" prefix (VLM_MODEL=gemini-3.1-flash-lite, LSS_LLM_MODEL=gemini-3.1-flash-lite).
# OPENROUTER_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Seconds between model requests, shared by all threads. 4.5 stays under 15 requests a minute (Gemini API free tier). 0 = no wait.
LLM_MIN_INTERVAL_S=0

# Safety Agent vision model: any OpenRouter model whose input modalities include `image`
VLM_MODEL=qwen/qwen3.7-flash

# Gemba Kaizen Agent LLM: any OpenRouter chat model with JSON output, e.g. google/gemini-3.1-flash-lite,
# google/gemini-3.8-flash, anthropic/claude-haiku-5.5, openai/gpt-5-mini
LSS_LLM_MODEL=google/gemini-3.1-flash-lite

# Voice Agent (chatbot with speech). Without a key the chat still answers (text only) and the browser's own voice is used.
ELEVENLABS_API_KEY=
# Any voice from your ElevenLabs library; the default is the premade "Rachel"
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_flash_v2_5 is cheap and fast; eleven_v3 covers the most languages (check Thai and Japanese for your voice)
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Chat model for the Voice Agent (defaults to LSS_LLM_MODEL)
VOICE_LLM_MODEL=
