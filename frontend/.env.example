# Drizzle (optional: only the database module uses it)
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# ai_backend base URL, used by the /api/* proxy (server-side only)
AI_BACKEND_URL="http://localhost:8000"

# Let the UI point the /api proxy at another ai_backend (Backend address box on the Video and Voice pages).
# Set to "false" on a public deployment: the proxy would otherwise forward to any address a visitor types.
ALLOW_BACKEND_OVERRIDE="true"
