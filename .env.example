# Keep this stable across deployments so Compose reuses the existing containers and volumes.
# This VM already uses the legacy project name ai_backend; do not rename it on an existing install.
COMPOSE_PROJECT_NAME=ai_backend

# Both DNS A records must point at this VM before starting the HTTPS stack.
DOMAIN=valz.limitlesstech-co.com
API_DOMAIN=gemba.limitlesstech-co.com
# Model credentials belong in ai_backend/.env, not here.
